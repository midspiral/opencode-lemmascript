// Generated by lsc from index.ts

datatype Option<T> = None | Some(value: T)

function SeqFindIndex<T>(s: seq<T>, p: T -> bool): int
  ensures -1 <= SeqFindIndex(s, p) < |s|
  ensures SeqFindIndex(s, p) >= 0 ==> p(s[SeqFindIndex(s, p)])
  ensures SeqFindIndex(s, p) >= 0 ==>
    (forall i: nat :: i < SeqFindIndex(s, p) ==> !p(s[i]))
  ensures SeqFindIndex(s, p) == -1 ==> (forall i: nat :: i < |s| ==> !p(s[i]))
{
  SeqFindIndexFrom(s, p, 0)
}

function SeqFindIndexFrom<T>(s: seq<T>, p: T -> bool, from: nat): int
  requires from <= |s|
  ensures -1 <= SeqFindIndexFrom(s, p, from) < |s|
  ensures SeqFindIndexFrom(s, p, from) >= 0 ==>
    from <= SeqFindIndexFrom(s, p, from) && p(s[SeqFindIndexFrom(s, p, from)])
  ensures SeqFindIndexFrom(s, p, from) >= 0 ==>
    (forall i: nat :: from <= i < SeqFindIndexFrom(s, p, from) ==> !p(s[i]))
  ensures SeqFindIndexFrom(s, p, from) == -1 ==>
    (forall i: nat :: from <= i < |s| ==> !p(s[i]))
  decreases |s| - from
{
  if from >= |s| then -1
  else if p(s[from]) then from as int
  else SeqFindIndexFrom(s, p, from + 1)
}

function {:axiom} StringSplit(s: string, d: string): seq<string>
  requires |d| > 0
  ensures |StringSplit(s, d)| >= 1
  ensures |StringSplit(s, d)| <= |s| + 1
  ensures forall k :: 0 <= k < |StringSplit(s, d)| ==> |StringSplit(s, d)[k]| <= |s|

function StringTrimLeft(s: string): string
  ensures |StringTrimLeft(s)| <= |s|
  ensures StringTrimLeft(s) == "" || (|StringTrimLeft(s)| > 0 && StringTrimLeft(s)[0] != ' ')
  decreases |s|
{
  if |s| == 0 then ""
  else if s[0] == ' ' then StringTrimLeft(s[1..])
  else s
}

function StringTrimRight(s: string): string
  ensures |StringTrimRight(s)| <= |s|
  decreases |s|
{
  if |s| == 0 then ""
  else if s[|s|-1] == ' ' then StringTrimRight(s[..|s|-1])
  else s
}

function StringTrim(s: string): string
{
  StringTrimRight(StringTrimLeft(s))
}

function {:axiom} stripHeredoc(input: string): string

datatype ParsePatchHeaderResult = ParsePatchHeaderResult(filePath: string, movePath: Option<string>, nextIdx: int)

datatype ParseUpdateFileChunksResult = ParseUpdateFileChunksResult(chunks: seq<UpdateFileChunk>, nextIdx: int)

datatype UpdateFileChunk = UpdateFileChunk(old_lines: seq<string>, new_lines: seq<string>, change_context: Option<string>, is_end_of_file: Option<bool>)

datatype ParseAddFileContentResult = ParseAddFileContentResult(content: string, nextIdx: int)

datatype ParsePatchResult = ParsePatchResult(hunks: seq<Hunk>)

datatype Hunk = add(path: string, contents: string) | delete(path: string) | update(path: string, move_path: Option<string>, chunks: seq<UpdateFileChunk>)

method parsePatchHeader(lines: seq<string>, startIdx: int) returns (res: Option<ParsePatchHeaderResult>)
  requires (0 <= startIdx)
  requires (startIdx < |lines|)
  ensures (match res { case Some(i_result_val) => (i_result_val.nextIdx >= (startIdx + 1)) case None => true })
  ensures (match res { case Some(i_result_val) => (i_result_val.nextIdx <= (startIdx + 2)) case None => true })
  ensures (match res { case Some(i_result_val) => (i_result_val.nextIdx <= |lines|) case None => true })
{
  var line := lines[startIdx];
  if (|line| >= |"*** Add File:"| && line[..|"*** Add File:"|] == "*** Add File:") {
    var filePath := StringTrim(line[|"*** Add File:"|..]);
    return (if (|filePath| > 0) then Option.Some(ParsePatchHeaderResult(filePath, None, (startIdx + 1))) else Option.None);
  }
  if (|line| >= |"*** Delete File:"| && line[..|"*** Delete File:"|] == "*** Delete File:") {
    var filePath := StringTrim(line[|"*** Delete File:"|..]);
    return (if (|filePath| > 0) then Option.Some(ParsePatchHeaderResult(filePath, None, (startIdx + 1))) else Option.None);
  }
  if (|line| >= |"*** Update File:"| && line[..|"*** Update File:"|] == "*** Update File:") {
    var filePath := StringTrim(line[|"*** Update File:"|..]);
    var movePath := None;
    var nextIdx := (startIdx + 1);
    if ((nextIdx < |lines|) && (|lines[nextIdx]| >= |"*** Move to:"| && lines[nextIdx][..|"*** Move to:"|] == "*** Move to:")) {
      movePath := Some(StringTrim(lines[nextIdx][|"*** Move to:"|..]));
      nextIdx := (nextIdx + 1);
    }
    return (if (|filePath| > 0) then Option.Some(ParsePatchHeaderResult(filePath, movePath, nextIdx)) else Option.None);
  }
  return None;
}

method parseUpdateFileChunks(lines: seq<string>, startIdx: int) returns (res: ParseUpdateFileChunksResult)
  requires (0 <= startIdx)
  requires (startIdx <= |lines|)
  ensures (startIdx <= res.nextIdx)
  ensures (res.nextIdx <= |lines|)
{
  var chunks: seq<UpdateFileChunk> := [];
  var i := startIdx;
  while ((i < |lines|) && !((|lines[i]| >= |"***"| && lines[i][..|"***"|] == "***")))
    invariant (startIdx <= i)
    invariant (i <= |lines|)
    decreases (|lines| - i)
  {
    if (|lines[i]| >= |"@@"| && lines[i][..|"@@"|] == "@@") {
      var contextLine := StringTrim(lines[i][2..]);
      i := (i + 1);
      var oldLines: seq<string> := [];
      var newLines: seq<string> := [];
      var isEndOfFile := false;
      while (((i < |lines|) && !((|lines[i]| >= |"@@"| && lines[i][..|"@@"|] == "@@"))) && !((|lines[i]| >= |"***"| && lines[i][..|"***"|] == "***")))
        invariant (0 <= i)
        invariant (i <= |lines|)
        decreases (|lines| - i)
      {
        var changeLine := lines[i];
        if (changeLine == "*** End of File") {
          isEndOfFile := true;
          i := (i + 1);
          break;
        }
        if (|changeLine| >= |" "| && changeLine[..|" "|] == " ") {
          var content := changeLine[1..];
          oldLines := (oldLines + [content]);
          newLines := (newLines + [content]);
        } else if (|changeLine| >= |"-"| && changeLine[..|"-"|] == "-") {
          oldLines := (oldLines + [changeLine[1..]]);
        } else if (|changeLine| >= |"+"| && changeLine[..|"+"|] == "+") {
          newLines := (newLines + [changeLine[1..]]);
        }
        i := (i + 1);
      }
      chunks := (chunks + [UpdateFileChunk(oldLines, newLines, (if (|contextLine| > 0) then Some(contextLine) else None), (if isEndOfFile then Some(isEndOfFile) else None))]);
    } else {
      i := (i + 1);
    }
  }
  return ParseUpdateFileChunksResult(chunks, i);
}

method parseAddFileContent(lines: seq<string>, startIdx: int) returns (res: ParseAddFileContentResult)
  requires (0 <= startIdx)
  requires (startIdx <= |lines|)
  ensures (startIdx <= res.nextIdx)
  ensures (res.nextIdx <= |lines|)
{
  var content := "";
  var i := startIdx;
  while ((i < |lines|) && !((|lines[i]| >= |"***"| && lines[i][..|"***"|] == "***")))
    invariant (startIdx <= i)
    invariant (i <= |lines|)
    decreases (|lines| - i)
  {
    if (|lines[i]| >= |"+"| && lines[i][..|"+"|] == "+") {
      content := (content + (lines[i][1..] + "\n"));
    }
    i := (i + 1);
  }
  if (|content| >= |"\n"| && content[|content|-|"\n"|..] == "\n") {
    content := content[0..|content|-1];
  }
  return ParseAddFileContentResult(content, i);
}

method parsePatch(patchText: string) returns (res: ParsePatchResult)
  requires (|patchText| >= 0)
{
  var i_t0 := stripHeredoc(StringTrim(patchText));
  var cleaned := i_t0;
  var lines := StringSplit(cleaned, "\n");
  var hunks: seq<Hunk> := [];
  var i := 0;
  var beginMarker := "*** Begin Patch";
  var endMarker := "*** End Patch";
  var beginIdx := SeqFindIndex(lines, (line: string) => (StringTrim(line) == beginMarker));
  var endIdx := SeqFindIndex(lines, (line: string) => (StringTrim(line) == endMarker));
  if (((beginIdx == -1) || (endIdx == -1)) || (beginIdx >= endIdx)) {
    assert false;
  }
  i := (beginIdx + 1);
  ghost var hunkStartIdx: seq<int> := [];
  ghost var coveredCount: int := 0;
  ghost var skippedCount: int := 0;
  while (i < endIdx)
    invariant ((beginIdx + 1) <= i)
    invariant (i <= |lines|)
    invariant (endIdx < |lines|)
    invariant (|hunkStartIdx| == |hunks|)
    invariant (|hunks| <= (i - (beginIdx + 1)))
    invariant forall k: nat :: ((k < |hunkStartIdx|) ==> (((beginIdx + 1) <= hunkStartIdx[k]) && (hunkStartIdx[k] < i)))
    invariant forall k: nat :: (((k + 1) < |hunkStartIdx|) ==> (hunkStartIdx[k] < hunkStartIdx[(k + 1)]))
    invariant ((coveredCount + skippedCount) == (i - (beginIdx + 1)))
    decreases (|lines| - i)
  {
    var i_t1 := parsePatchHeader(lines, i);
    var header := i_t1;
    match header {
      case Some(i_header_val) =>
        if (|lines[i]| >= |"*** Add File:"| && lines[i][..|"*** Add File:"|] == "*** Add File:") {
          var i_t2 := parseAddFileContent(lines, i_header_val.nextIdx);
          var i_destr0 := i_t2;
          var content := i_destr0.content;
          var nextIdx := i_destr0.nextIdx;
          hunkStartIdx := (hunkStartIdx + [i]);
          coveredCount := (coveredCount + (nextIdx - i));
          hunks := (hunks + [add(i_header_val.filePath, content)]);
          i := nextIdx;
        } else if (|lines[i]| >= |"*** Delete File:"| && lines[i][..|"*** Delete File:"|] == "*** Delete File:") {
          hunkStartIdx := (hunkStartIdx + [i]);
          coveredCount := (coveredCount + (i_header_val.nextIdx - i));
          hunks := (hunks + [delete(i_header_val.filePath)]);
          i := i_header_val.nextIdx;
        } else if (|lines[i]| >= |"*** Update File:"| && lines[i][..|"*** Update File:"|] == "*** Update File:") {
          var i_t3 := parseUpdateFileChunks(lines, i_header_val.nextIdx);
          var i_destr1 := i_t3;
          var chunks := i_destr1.chunks;
          var nextIdx := i_destr1.nextIdx;
          hunkStartIdx := (hunkStartIdx + [i]);
          coveredCount := (coveredCount + (nextIdx - i));
          hunks := (hunks + [update(i_header_val.filePath, i_header_val.movePath, chunks)]);
          i := nextIdx;
        } else {
          skippedCount := (skippedCount + 1);
          i := (i + 1);
        }
      case None =>
        skippedCount := (skippedCount + 1);
        i := (i + 1);
    }
  }
  return ParsePatchResult(hunks);
}
